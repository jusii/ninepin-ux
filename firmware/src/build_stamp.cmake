# writes build_stamp.c with the release version (VERSION: "0.9.0", or "dev" for
# a build that is no release) and the time of this build (every build, not only when
# the file that shows it was recompiled); only touches the file when it changed
string(TIMESTAMP AHP_STAMP "%Y-%m-%d %H:%M:%S")
set(AHP_TEXT "// generated by build_stamp.cmake\nchar const ahp_build_stamp[] = \"${AHP_STAMP}\";\nchar const ahp_version[] = \"${VERSION}\";\n")
if (EXISTS ${OUT})
  file(READ ${OUT} AHP_OLD)
endif ()
if (NOT "${AHP_OLD}" STREQUAL "${AHP_TEXT}")
  file(WRITE ${OUT} "${AHP_TEXT}")
endif ()
