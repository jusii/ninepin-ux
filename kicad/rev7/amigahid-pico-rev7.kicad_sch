		(uuid "c74e94f9-c722-5566-84f5-f26f5d6eef77")
	)
	(text "AMIGA_5V (keyboard connector / A500 header) -> F1 -> AMIGA_5V_FUSED -> D1 -> SYS5V; USB-C -> D2 -> SYS5V. Either source alone runs the board."
		(exclude_from_sim no)
		(at 20 31.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "60b48baa-ec96-5bb4-b618-255b16c6511b")
	)
	(text "AMIGA_5V_FUSED feeds the bus switches and the Amiga-side pull-ups only, so a USB-C-powered board never back-feeds an Amiga that is off."
		(exclude_from_sim no)
		(at 20 35 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "22935eaf-ea46-560e-8314-3f97a9b3389f")
	)
	(text "F1 750 mA fitted (rev6 bring-up measured the stack well under that). SYS5V -> U3 -> +3V3 (RP2350, RM2, flash, OLED, mux). R60 bleeds D1 leakage off the fused rail."
		(exclude_from_sim no)
		(at 20 38.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "04458201-322e-5a41-8c31-d50c7d46e39d")
	)
