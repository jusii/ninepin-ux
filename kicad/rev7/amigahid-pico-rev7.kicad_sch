	(text "mcu: RP2350A, 16 MB QSPI flash, 12 MHz crystal, BOOT / RESET, SWD"
		(exclude_from_sim no)
		(at 410 204.66 0)
		(effects
			(font
				(size 3.0 3.0)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "68551510-a35e-5373-a749-9064e4509c65")
	)
	(text "Per the RP2350 hardware design guide / Pico 2 W: VREG_VIN and VREG_AVDD on 3V3 (AVDD through 33R + 4.7uF), DVDD 4.7uF at pin 23 + 100nF at 6/39, 4.7uF CIN at VREG_VIN, 100nF per IOVDD pin, one 100nF shared by USB_OTP_VDD/QSPI_IOVDD."
		(exclude_from_sim no)
		(at 410 212.16 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "2efc454c-1c31-5299-8b5f-5c4f604daf00")
	)
	(text "BOOT pulls QSPI_SS low at reset (USB bootloader on USB-C); RESET pulls RUN low."
