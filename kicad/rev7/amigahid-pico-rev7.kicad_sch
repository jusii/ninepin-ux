	(text "usb: USB-C (power + device for flashing), USB-A host, 2:1 mux on the RP2350 USB PHY"
		(exclude_from_sim no)
		(at 410 24 0)
		(effects
			(font
				(size 3.0 3.0)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b3bbeca8-22b4-5ac7-983d-8a102043d956")
	)
	(text "U5 selects D1 (USB-C) when usb_sel is low, which R48 guarantees at reset, so a fresh board enumerates on USB-C. Firmware sets GPIO17 high to switch to the USB-A host port."
		(exclude_from_sim no)
		(at 410 31.5 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "44e94d59-a1cd-560a-8ac7-12a52fd629cd")
	)
	(text "USB-C is a UFP: 5.1k on each CC. VBUS -> AUX_5V -> D2 -> SYS5V. USB-A VBUS is SYS5V through F2."
		(exclude_from_sim no)
		(at 410 35 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "8d3c02ad-c2d6-5a63-b7fe-cfb9b16cfe50")
	)
